{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgetts-cloudflare",
  "account_id": "9151f72e404dd53f20b8e6667893237d",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // 自定义域名（zone: rei8t.dev）
  "routes": [{ "pattern": "edge-tts.rei8t.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // 前端（React + Kumo）：pnpm build 把 web/ 构建到 ./public。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    // 管理员（逗号分隔）
    "ADMIN_EMAILS": "reiy.leoz@gmail.com",
    // 允许用网页合成的邮箱（逗号分隔）；空 = 任意 Google 账号
    "ALLOWED_EMAILS": "",
    // 网页端单次最多字符数（外部 API 不限）
    "WEB_MAX_CHARS": "10000"
  }
  // Secrets（不要提交；wrangler secret put … 或在 CF 控制台添加）：
  //   API_KEY（外部 /v1/* 用）、SESSION_SECRET（本项目单独生成）、GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET
  // Google Cloud 授权回调地址：https://edge-tts.rei8t.dev/auth/callback 与 http://localhost:8787/auth/callback
}
