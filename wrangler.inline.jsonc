{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 与 wrangler.jsonc 同一个 Worker，区别：public/ 内联进脚本（用 API Token 部署时 Static Assets 上传会 401）。
  // pnpm deploy:inline
  "name": "edgetts-cloudflare",
  "account_id": "9151f72e404dd53f20b8e6667893237d",
  "main": "worker-inline/entry.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  // 自定义域名（zone: rei8t.dev）
  "routes": [{ "pattern": "edgetts-cloudflare.rei8t.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // 保留控制台里加的变量/secret
  "keep_vars": true,
  "vars": {
    "ADMIN_EMAILS": "reiy.leoz@gmail.com",
    "ALLOWED_EMAILS": "",
    "WEB_MAX_CHARS": "10000"
  }
  // Secrets：API_KEY、SESSION_SECRET、GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET
}
